depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.2.0"}
  "core" {>= "v0.16"}
  "ppx_jane"
  "base_quickcheck"
  "yojson"
  "ppx_yojson_conv"
  "expect_test_helpers_core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo:
  "git+https://github.com/AdnanDervisevic/symbaroum-combat-tracker.git"
