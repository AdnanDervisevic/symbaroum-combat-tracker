# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Headless front end for the Symbaroum combat engine"
description:
  "Reads a save file, prints the world it describes and the corrections appliedon the way in. Separate from the `symbaroum` package on purpose: it depends on`core_unix`, and `dune build -p symbaroum` has to stay a proof that the coredoes not."
maintainer: ["Adnan Dervisevic"]
authors: ["Adnan Dervisevic"]
license: "MIT"
homepage: "https://github.com/AdnanDervisevic/symbaroum-combat-tracker"
bug-reports:
  "https://github.com/AdnanDervisevic/symbaroum-combat-tracker/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.2.0"}
  "symbaroum" {= version}
  "core"
  "core_unix"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo:
  "git+https://github.com/AdnanDervisevic/symbaroum-combat-tracker.git"
