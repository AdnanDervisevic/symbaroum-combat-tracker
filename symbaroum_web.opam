# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Bonsai web UI for the Symbaroum combat tracker"
maintainer: ["Adnan Dervisevic"]
authors: ["Adnan Dervisevic"]
license: "MIT"
homepage: "https://github.com/AdnanDervisevic/symbaroum-combat-tracker"
bug-reports:
  "https://github.com/AdnanDervisevic/symbaroum-combat-tracker/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.2.0"}
  "symbaroum" {= version}
  "bonsai"
  "virtual_dom"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo:
  "git+https://github.com/AdnanDervisevic/symbaroum-combat-tracker.git"
